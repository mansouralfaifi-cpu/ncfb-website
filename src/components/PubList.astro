---
import Icon from './Icon.astro';
import pubs from '../content/publications.json';
import { type Lang, t, href, L } from '../lib/site';
interface Props { lang: Lang; limit?: number }
const { lang, limit } = Astro.props;
const items = [...pubs.items].sort((a, b) => b.date.localeCompare(a.date)).slice(0, limit || undefined);
const page = href(lang, 'library-publications');
const months = t(lang, 'monthsLong') as string[];
const when = (d: string) => `${months[Number(d.slice(5, 7)) - 1]} ${d.slice(0, 4)}`;
---
<div class="pubs">
  {items.map((p) => (
    <article class="pub" data-type={p.type}><div class="meta"><span class="badge">{t(lang, p.type)}</span><time class="caption muted" datetime={p.date}>{when(p.date)}</time></div><div style="display:grid;gap:var(--space-half)"><h3 class="h4"><a href={p.file || page}>{L(p.title, lang)}</a></h3>{L((p as any).summary, lang) && <p class="small muted">{L((p as any).summary, lang)}</p>}</div>{p.file && <a class="btn btn-text" href={p.file} aria-label={t(lang, 'downloadOf', { t: L(p.title, lang) })} download><Icon name="download" />{t(lang, 'downloadPdf')}</a>}</article>
  ))}
</div>
