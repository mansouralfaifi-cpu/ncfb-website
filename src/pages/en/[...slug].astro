---
import PageView from '../../components/PageView.astro';
import { allRoutes } from '../../lib/site';
export function getStaticPaths() {
  return allRoutes().map((route) => ({ params: { slug: route.path || undefined }, props: { route } }));
}
const { route } = Astro.props;
---
<PageView lang="en" route={route} />
